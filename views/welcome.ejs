<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Node.js Hosting Test App</title>
  <!-- Link to the external premium stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <div class="card">
      <!-- Active Server Status Badge -->
      <div class="status-badge">
        <span class="status-dot"></span>
        Server is Online
      </div>
      
      <!-- App Title -->
      <h1>Node.js Hosting Test App</h1>
      
      <!-- Welcome Message -->
      <p>
        Welcome to your Express.js test application! This light-weight interface is designed to verify that your cPanel Node.js hosting environment, session handling, and package execution are working perfectly.
      </p>
      
      <!-- Call to Action Login Button -->
      <a href="/login" class="btn btn-primary" id="welcome-login-btn">
        Login to Dashboard
      </a>
    </div>
    
    <!-- Footer credits or links -->
    <div class="footer">
      Node.js Hosting Test App &bull; Powered by Express.js
    </div>
  </div>
</body>
</html>
